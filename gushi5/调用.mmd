        ST["small_tool.py
safe_json_loads() / load_prompt()
resolve_npc_name()
apply_npc_delta() / apply_player_delta()
merge_delta() / strip_empty_delta()
resolve_move_markers()"]
        CLK["GameClock<br/>游戏时间(24h/时辰制)
advance(minutes)
now_str()"]
        LOG["log.py<br/>日志引擎 单例
按session分文件"]
    end

