---
title: 故事3 完整流水线 v4 — N1→N2→N3→[N4N5N6并行]→[N7+N8并行]→N9→循环
---
%%{init: {'theme': 'default', 'themeVariables': {'primaryColor': '#eceff1', 'primaryTextColor': '#37474f', 'primaryBorderColor': '#90a4ae', 'lineColor': '#90a4ae', 'fontSize': '16px'}}}%%
flowchart TB
    %% =========================================
    %% 数据基础层
    %% =========================================
    subgraph DATA["📦 数据基础层"]
        direction LR
        data_world["🌍 B1WorldLayer<br/>规则 / 状态 / 演变规则 / 知识 / 地点树"]
        data_npcs["👥 B3NPCListLayer<br/>10张表 / 势力分组 / JSON加载"]
        data_player["🎮 B4PlayerLayer<br/>名称 / 状态 / 持有物 / 描述"]
        data_clock["⏰ GameClock<br/>独立模拟时间"]
        data_ctx["📝 ContextHistory ×3<br/>global(玩家可见) / event(AI用·随新事件清空)<br/>director(AI用·持久·不向玩家暴露)"]
    end

    %% =========================================
    %% N1 输入层
    %% =========================================
    subgraph N1["N1 玩家输入层 ✅"]
        direction TB
        n1_input["玩家输入 raw_input"]
        n1_cmd{"命令判断"}
        n1_cmds["命令处理<br/>存档: /save /load /saves /quick_save /quick_load<br/>查看: /context /npcs /player /player inv /player desc<br/>撤回: !!  /  退出: exit"]
        n1_undo["!! 撤回<br/>gc.restore(last_snapshot)<br/>+ n9_director.restore(last_n9_state)"]
        n1_move["移动标记检测<br/>resolve_move_markers()<br/>{移动} / /move"]
        n1_nav["交互式导航 → 选移动方式<br/>B1WorldLayer.navigate_interactive()"]
        n1_done["(player_input, move_info)"]

        n1_input --> n1_cmd
        n1_cmd -- "/命令或exit" --> n1_cmds --> n1_done
        n1_cmd -- "!!" --> n1_undo --> n1_done
        n1_cmd -- "普通输入" --> n1_move
        n1_move -- "含移动标记" --> n1_nav --> n1_done
        n1_move -- "无标记" --> n1_done
    end

    %% =========================================
    %% N2 事件层
    %% =========================================
    subgraph N2["N2 事件层 ✅ LLM"]
        direction TB
        n2_input["输入：event_context + 当前event_npc + 全部NPC名<br/>+ director_context(幕后情报·仅AI参考)"]
        n2_llm["LLM判断<br/>prompt/N2_contextRetrieval_sys.txt"]
        n2_out["输出：is_new_event / add_npc / del_npc<br/>add_related_npc / del_related_npc / move_to"]
        n2_new{"is_new_event?"}
        n2_yes["清空 event_context<br/>event_context.new_context()"]
        n2_no["延续事件"]
        n2_filter["代码层防幻觉<br/>resolve_npc_name() 子串匹配<br/>'林知夏' → '林组长...林知夏（本名）'"]

        n2_input --> n2_llm --> n2_out --> n2_new
        n2_new -- "true" --> n2_yes --> n2_filter
        n2_new -- "false" --> n2_no --> n2_filter
    end

    %% =========================================
    %% N3 感知层
    %% =========================================
    subgraph N3["N3 感知层 ✅ LLM"]
        direction TB
        n3_input["输入：event_context + event_npc + related_npc<br/>+ 玩家位置 + director_context(幕后情报)"]
        n3_llm["LLM判断<br/>prompt/N3_informationFiltering_sys.txt"]
        n3_event["事件涉及的npc<br/>'玩家对你说：...'"]
        n3_related["事件涉及/潜在npc<br/>'玩家对[名]说：...'"]
        n3_ground["地段传播<br/>{msg, level, mask}"]

        n3_input --> n3_llm
        n3_llm --> n3_event & n3_related & n3_ground
    end

    %% =========================================
    %% N4→N5→N6 并行
    %% =========================================
    subgraph NPC_PIPE["⚡ N4→N5→N6 并行 ThreadPoolExecutor(max_workers=6)"]
        direction TB
        npipe_tasks["组装 tasks：event_npc(打印回应) + related_npc(静默)<br/>每NPC一条独立流水线"]
        npipe_pool["并行提交 gc.process_npc_pipeline()"]

        subgraph N4["N4 推理层 ✅ LLM"]
            n4_llm["reason_for_npc()<br/>prompt/N4_reasoning_sys<br/>更新待解释事件表"]
        end
        subgraph N5["N5 回应层 ✅ LLM"]
            n5_llm["response_say()<br/>prompt/N5_response_sys<br/>不接受玩家实例，产出回应+内心想法"]
        end
        subgraph N6["N6 更新层 ✅ LLM"]
            n6_llm["update_for_npc()<br/>prompt/N6_update_sys<br/>唯一接受玩家实例<br/>产出delta增量 + strip_empty_delta()"]
        end
        subgraph MERGE["合并"]
            merge_delta["merge_delta() 合并多NPC的玩家增量<br/>apply_player_delta() 写回玩家"]
            merge_sync["sync_npc_to_lists()<br/>更新后NPC同步到 event_npc + all_npc_list"]
        end

        npipe_tasks --> npipe_pool --> N4 --> N5 --> N6
        N6 --> merge_delta --> merge_sync
    end

    %% =========================================
    %% N7 + N8 并行
    %% =========================================
    subgraph N7N8["⏱️ N7+N8 并行 ThreadPoolExecutor(max_workers=2)"]
        direction LR
        subgraph N7["N7 传播层 ✅ 纯规则"]
            n7_in["输入：N3地段传播 {msg,level,mask}<br/>亲历NPC名单 / 玩家位置"]
            n7_calc["LCA距离 → level确定层级<br/>mask概率 → 随机筛选"]
            n7_out["输出：{NPC名: ['(传闻)消息']}<br/>写入NPC.observation · 排除亲历者"]
            n7_in --> n7_calc --> n7_out
        end
        subgraph N8["N8 时间层 ✅ 规则+LLM"]
            n8_disp{"移动?"}
            n8_rule["规则：segments×15min×系数<br/>步行1.0 跑步0.5 电动车0.4 公交0.3"]
            n8_llm_ability["LLM：读上下文判断意图<br/>逃命/显圣/隐藏<br/>prompt/N8_time_ability_sys"]
            n8_llm_dialogue["LLM：读对话估算<br/>prompt/N8_time_dialogue_sys"]
            n8_advance["game_clock.advance()"]
            n8_disp -- "常规移动" --> n8_rule --> n8_advance
            n8_disp -- "异能移动" --> n8_llm_ability --> n8_advance
            n8_disp -- "无移动" --> n8_llm_dialogue --> n8_advance
        end
    end

    %% =========================================
    %% N9 导演层
    %% =========================================
    subgraph N9["🎬 N9 导演层 ✅ LLM · 每轮最后"]
        direction TB

        subgraph N9_IN["📥 输入组装"]
            direction LR
            n9in_rules["世界演变规则列表"]
            n9in_state["当前世界状态列表"]
            n9in_trig["已触发规则 {序号:进度}"]
            n9in_time["当前游戏时间"]
            n9in_player["玩家 {名称,位置,实力}"]
            n9in_events["最近事件摘要(5轮)"]
            n9in_dir["导演历史(director_context)"]
            n9in_resp["NPC回应摘要(前80字×5)"]
            n9in_n7["N7传播结果"]
            n9in_narr["最近环境叙事 + 已叙述主题"]
        end

        n9_llm["LLM判断<br/>prompt/N9_director_sys.txt"]

        subgraph N9_FILTER["🛡️ 代码层防幻觉 + 主题追踪"]
            n9f1["① 规则原文 ∈ 规则列表?<br/>过滤幻觉规则"]
            n9f2["② 规则序号 ∉ triggered_rules?<br/>防重复触发"]
            n9f3["③ resolve_npc_name() 子串+纯名匹配<br/>'赵铁手(本名)'→'赵工...赵铁手(黑户社区)'"]
            n9f4["④ 更新缓存<br/>triggered_rules + recent_narrations + narrated_themes"]
        end

        subgraph N9_OUT["📤 四路输出 · 按可见性分层"]
            direction LR
            n9o1["① 规则触发<br/>🟢玩家可见叙述 → 打印+global_context<br/>🔴幕后详情 → director_context<br/>状态变更 → 世界状态列表"]
            n9o2["② 环境叙事(0-1条)🟢<br/>→ 灰字打印·小点前缀<br/>→ global_context<br/>主题追踪防重复"]
            n9o3["③ NPC自主行为(0-3个)🔴<br/>→ NPC.observation<br/>→ director_context"]
            n9o4["④ 剧情级传播(0-2条)🔴<br/>→ 到达NPC.observation<br/>→ director_context"]
        end

        N9_IN --> n9_llm --> N9_FILTER
        n9f1 --> n9f2 --> n9f3 --> n9f4 --> N9_OUT
    end

    %% =========================================
    %% 主流程连线
    %% =========================================
    n1_done --> N2
    N2 --> N3
    N3 --> NPC_PIPE
    NPC_PIPE --> N7N8
    N7N8 --> N9
    N9 --> LOOP["🔄 回到N1"]

    N9_OUT -. "③④ 幕后信息" .-> DIRCTX["📋 director_context<br/>持久·不随事件清空<br/>玩家不可见<br/>/context director 可查(调试)"]
    DIRCTX -. "下轮输入" .-> N2
    DIRCTX -.-> N3
    DIRCTX -.-> N9

    %% =========================================
    %% 存档持久化
    %% =========================================
    subgraph SAVE["💾 存档系统 ✅"]
        direction LR
        sv_snap["gc.snapshot()<br/>上下文/NPC/玩家/世界/时钟"]
        sv_n9["n9_director.to_dict() → gc._n9_state<br/>含 triggered_rules / narrations / themes"]
        sv_save["build_save_state()<br/>JSON + 日志"]
        sv_load["rebuild_game_state()<br/>+ n9_director.restore()"]
    end
    N9 -.-> sv_n9 --> sv_save

    %% =========================================
    %% 工具函数
    %% =========================================
    subgraph TOOLS["🔧 公共工具 common/small_tool.py"]
        direction LR
        t1["resolve_npc_name()<br/>3级匹配：精确→子串→纯名(括号前)"]
        t2["safe_json_loads()<br/>剥离markdown·降级解析"]
        t3["strip_empty_delta()<br/>清除LLM空增量"]
        t4["resolve_move_markers()<br/>移动标记→导航→方式选择"]
        t5["merge_delta()/apply_player_delta()<br/>增量合并"]
    end

    %% =========================================
    %% 样式
    %% =========================================
    style N1 fill:#f0faf0,stroke:#81c784,color:#333
    style N2 fill:#f0f5ff,stroke:#64b5f6,color:#333
    style N3 fill:#fff8f0,stroke:#ffb74d,color:#333
    style N4 fill:#fff0f3,stroke:#e57373,color:#333
    style N5 fill:#faf0fa,stroke:#ba68c8,color:#333
    style N6 fill:#f0fafa,stroke:#4db6ac,color:#333
    style N7 fill:#fffff0,stroke:#fff176,color:#333
    style N8 fill:#f5f5ff,stroke:#7986cb,color:#333
    style N9 fill:#fff5f5,stroke:#ef9a9a,color:#333
    style DATA fill:#fafafa,stroke:#bdbdbd,color:#333
    style SAVE fill:#f8f8f8,stroke:#9e9e9e,color:#333
    style TOOLS fill:#f5f5f5,stroke:#bdbdbd,color:#333

    %% =========================================
    %% 层级速查
    %% =========================================
    subgraph LEGEND["📋 层级速查表"]
        direction LR
        L1["N1 输入 → 命令/移动"]
        L2["N2 事件 → LLM·新事件判断"]
        L3["N3 感知 → LLM·信息分发"]
        L4["N4 推理 → LLM·NPC思考"]
        L5["N5 回应 → LLM·NPC说话"]
        L6["N6 更新 → LLM·增量落地"]
        L7["N7 传播 → 规则·位置树谣言"]
        L8["N8 时间 → 规则+LLM·推进"]
        L9["N9 导演 → LLM·暗线推动"]
    end
